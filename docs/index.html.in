<!-- Installation -->
<div class="section">
    <div class="section-header">
        <div class="section-label">Get Started</div>
        <div class="section-title">Installation</div>
        <div class="section-desc">Add liburlparser to your project in seconds.</div>
    </div>
    <div class="tabbed-panel" id="install-panel">
        <div class="tab-bar" id="install-tabs">
            <button class="tab-btn active" data-tab="install-cli" onclick="switchTab('install','cli')">
                <i class="fa-solid fa-terminal"></i> CLI
            </button>
            <button class="tab-btn" data-tab="install-cpp" onclick="switchTab('install','cpp')">
                <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg> C++
            </button>
            <button class="tab-btn" data-tab="install-python" onclick="switchTab('install','python')">
                <i class="fa-brands fa-python"></i> Python
            </button>
        </div>

        <div class="tab-content" id="install-python">
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">bash</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-bash">pip install liburlparser</code></pre>
            </div>
            <div class="install-note">
                Requires Python 3.10+. Ships a pre-built native extension for Linux, macOS, and Windows — no compiler needed.
            </div>
        </div>

        <div class="tab-content" id="install-cpp">
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">CMake — FetchContent</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-cmake"># CMakeLists.txt
include(FetchContent)
FetchContent_Declare(
  liburlparser
  GIT_REPOSITORY https://github.com/mohammadraziei/liburlparser.git
  GIT_TAG        master
)
FetchContent_MakeAvailable(liburlparser)

target_link_libraries(my_app PRIVATE url::base)</code></pre>
            </div>
            <div class="install-note">
                Requires CMake 3.19+ and a C++17-compatible compiler. Link against <code>url::base</code> and include <code>urlparser.h</code>.
            </div>
        </div>

        <div class="tab-content active" id="install-cli">
            <div class="section-label" style="margin-bottom:1rem">Option 1 — pip <span style="font-size:0.75rem;color:var(--fg2);text-transform:none;letter-spacing:0">(recommended)</span></div>
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">bash</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-bash">pip install liburlparser</code></pre>
            </div>
            <div class="install-note" style="margin-bottom:1.5rem">
                The Python package ships a pre-built native extension — no compiler or CMake needed. After install, the CLI is available as <code>python -m liburlparser</code>.
            </div>

            <div class="section-label" style="margin-bottom:1rem">Option 2 — build with CMake</div>
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">bash</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-bash">git clone https://github.com/mohammadraziei/liburlparser.git
cd liburlparser
cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_PYTHON=ON
cmake --build build -j$(nproc)</code></pre>
            </div>
            <div class="install-note">
                Requires CMake 3.19+, a C++17-compatible compiler, and Python 3.10+. Useful for a custom build configuration or a platform without a pre-built wheel.
            </div>
        </div>
    </div>
</div>

<div class="divider"></div>

<!-- Examples -->
<div class="section">
    <div class="section-header">
        <div class="section-label">Usage</div>
        <div class="section-title">Quick Examples</div>
        <div class="section-desc">Parse a URL or host and pull out its parts in a few lines of code.</div>
    </div>
    <div class="tabbed-panel" id="example-panel">
        <div class="tab-bar" id="example-tabs">
            <button class="tab-btn active" data-tab="example-cli" onclick="switchTab('example','cli')">
                <i class="fa-solid fa-terminal"></i> CLI
            </button>
            <button class="tab-btn" data-tab="example-cpp" onclick="switchTab('example','cpp')">
                <svg class="tab-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg> C++
            </button>
            <button class="tab-btn" data-tab="example-python" onclick="switchTab('example','python')">
                <i class="fa-brands fa-python"></i> Python
            </button>
        </div>

        <div class="tab-content" id="example-python">
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">python</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-python">from liburlparser import Url, Host

# Parse a URL
url = Url("https://mail.google.com/about")
print(url.domain)    # google
print(url.suffix)    # com
print(url.protocol)  # https

# Parse a bare host
host = Host("mail.google.com")
print(host.subdomain)  # mail
print(host.domain)     # google
print(host.suffix)     # com

# IPv4 / IPv6 hosts are classified automatically too
ip_host = Host("192.168.1.1")</code></pre>
            </div>
        </div>

        <div class="tab-content" id="example-cpp">
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">c++</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-cpp">#include &lt;iostream&gt;
#include "urlparser.h"

int main() {
    // Parse a URL
    urlparser::url url("https://www.example.com/path?param=value#section");

    std::cout &lt;&lt; "Protocol: " &lt;&lt; url.protocol()  &lt;&lt; "\n";
    std::cout &lt;&lt; "Domain: "   &lt;&lt; url.domain()    &lt;&lt; "\n";
    std::cout &lt;&lt; "Suffix: "   &lt;&lt; url.suffix()    &lt;&lt; "\n";
    std::cout &lt;&lt; "Path: "     &lt;&lt; url.abspath()   &lt;&lt; "\n";
    std::cout &lt;&lt; "Query: "    &lt;&lt; url.query()     &lt;&lt; "\n";
    std::cout &lt;&lt; "Fragment: " &lt;&lt; url.fragment()  &lt;&lt; "\n";

    // Access query parameters
    for (const auto&amp; param : url.params()) {
        std::cout &lt;&lt; param.first &lt;&lt; " = " &lt;&lt; param.second &lt;&lt; "\n";
    }

    // Get the host object directly
    urlparser::host host = url.host();
    std::cout &lt;&lt; "Full domain: " &lt;&lt; host.full_domain() &lt;&lt; "\n";
}</code></pre>
            </div>
        </div>

        <div class="tab-content active" id="example-cli">
            <div class="code-wrap">
                <div class="code-label">
                    <div class="code-lang-row"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-lang">bash</span></div>
                    <button class="copy-btn" onclick="copyCode(this)"><i class="fa-regular fa-copy"></i> copy</button>
                </div>
                <pre><code class="language-bash"># Parse a full URL, print it as JSON
python -m liburlparser --url "https://www.example.com/about?x=1"

# Classify a bare host (domain, IPv4, or IPv6 - picked automatically)
python -m liburlparser --host "192.168.1.1"

# Pull out just the parts you want
python -m liburlparser --url "https://www.example.com/about" --parts domain suffix

# Version / docstring
python -m liburlparser --version
python -m liburlparser --doc</code></pre>
            </div>
        </div>
    </div>
</div>

</div><!-- /wrap -->

